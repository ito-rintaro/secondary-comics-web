# 環境ごとに .env.dev / .env.prod を作る（Vite の --mode で切り替え）。
# 値は terraform output から取得する。これらはクライアントに埋め込まれる公開値だが、
# 環境ごとに変わるためファイルで管理する（コミットはしない）。
#
#   npm run dev          → .env.dev を読む
#   npm run build:dev    → .env.dev を読む（dev S3 へ）
#   npm run build:prod   → .env.prod を読む（prod S3 へ）
#
# CI（GitHub Actions）では .env ファイルは無いので、GitHub Environments の
# Variables から同名の VITE_* を build ステップに注入する。
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=ap-northeast-1
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
# 'true' で実 API に接続。未設定/それ以外はローカルの Demo（localStorage）。
VITE_USE_API=true
